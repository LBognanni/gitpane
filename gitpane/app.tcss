$canvas: #0d1117;
$surface: #161b22;
$raised-surface: #21262d;
$inactive-selection: #30363d;
$text: #f0f3f6;
$muted-text: #b1bac4;
$border: #6e7681;
$accent: #58a6ff;
$focus: #f2cc60;
$focused-selection: #174ea6;
$addition-background: #142b1d;
$removal-background: #351b20;
$diff-background: #272822;

Screen {
    background: $canvas;
    color: $text;
}

Screen > .screen--selection {
    background: $focused-selection;
    color: $text;
}

#main-tabs {
    height: 1fr;
}

Tabs {
    background: $surface;
    color: $muted-text;
}

Tab.--active {
    background: $raised-surface;
    color: $text;
    text-style: bold;
}

#body {
    height: 1fr;
    background: $canvas;
    color: $text;
}

#sidebar {
    width: 30;
    min-width: 15;
    background: $surface;
}

.sidebar-section {
    height: 1fr;
}

.panel-title,
.viewer-title,
#branch-status {
    background: $raised-surface;
    color: $muted-text;
    text-style: bold;
}

.panel-title {
    height: 1;
    width: 100%;
}

.panel-title-label {
    width: 1fr;
    height: 1;
}

.header-actions {
    display: none;
    width: auto;
    height: 1;
}

.header-actions.has-selection {
    display: block;
}

.viewer-title {
    height: 1;
    padding: 0 1;
}

.viewer-title-label {
    width: 1fr;
    height: 1;
}

.diff-actions {
    width: auto;
    height: 1;
}

#branch-status {
    height: 1;
    padding: 0 1;
}

VerticalSplitter {
    width: 1;
    height: 1fr;
    color: $border;
}

HorizontalSplitter {
    width: 1fr;
    height: 1;
    color: $border;
}

VerticalSplitter:hover,
HorizontalSplitter:hover,
VerticalSplitter.dragging,
HorizontalSplitter.dragging {
    color: $accent;
}

#staged-list,
#unstaged-list,
#commit-tree {
    height: 1fr;
    background: $surface;
    color: $text;
    border: solid $border;
}

#commit-tree {
    scrollbar-color: $accent;
}

#commit-tree > .tree--cursor {
    background: $focused-selection;
    color: $text;
    text-style: bold;
}

ListView > ListItem {
    height: 1;
    background: $surface;
    color: $text;
    layers: base actions;
}

ListView > ListItem > .file-label {
    layer: base;
    width: 100%;
    height: 1;
    text-wrap: nowrap;
}

ListView > ListItem > Static {
    text-wrap: nowrap;
}

.file-actions {
    layer: actions;
    dock: right;
    display: none;
    width: auto;
    height: 1;
    background: $surface;
}

ListView > ListItem.-hovered > .file-actions,
ListView:focus > ListItem.-highlight > .file-actions {
    display: block;
}

.file-action,
.header-action,
.diff-action {
    width: 3;
    min-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    margin: 0;
    border: none;
    color: $muted-text;
}

.file-action {
    background: transparent;
}

.header-action {
    background: $raised-surface;
}

.diff-action {
    background: transparent;
}

ListView > ListItem.-hovered > .file-actions {
    background: $raised-surface;
}

ListView:focus > ListItem.-highlight > .file-actions {
    background: $focused-selection;
}

.file-action:hover,
.file-action:focus,
.header-action:hover,
.header-action:focus,
.diff-action:hover,
.diff-action:focus {
    background: $raised-surface;
    color: $text;
    text-style: bold;
}

.discard-action:hover,
.discard-action:focus {
    color: #ff7b72;
}

ListView > ListItem.-hovered {
    background: $raised-surface;
}

ListView > ListItem.-highlight {
    background: $inactive-selection;
    color: $text;
}

ListView:focus {
    border: solid $focus;
}

ListView:focus > ListItem.-highlight {
    background: $focused-selection;
    color: $text;
    text-style: bold;
}

DiscardScreen {
    align: center middle;
    background: $canvas 70%;
}

ShortcutScreen {
    align: center middle;
    background: $canvas 70%;
}

#discard-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $raised-surface;
    border: solid $border;
}

#discard-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#discard-message {
    height: auto;
    margin: 1 0;
}

#discard-buttons {
    height: 3;
    align-horizontal: right;
}

#discard-buttons Button {
    margin-left: 1;
}

#shortcuts-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $raised-surface;
    border: solid $border;
}

#shortcuts-title {
    height: 1;
    color: $text;
    text-style: bold;
}

#shortcuts-list {
    height: auto;
    margin: 1 0;
    color: $text;
}

#close-shortcuts {
    align-horizontal: right;
}

#diff-view,
#preview-view {
    height: 1fr;
    overflow: scroll scroll;
    background: $diff-background;
    color: $text;
    scrollbar-color: $accent;
}

#diff-view.wrapped,
#preview-view.wrapped {
    overflow-x: hidden;
}

#files-body {
    height: 1fr;
    background: $canvas;
}

#files-tree {
    width: 30;
    min-width: 30;
    max-width: 30;
    background: $surface;
    color: $text;
    border-right: solid $border;
    scrollbar-color: $accent;
}

#diff-pane,
#preview-pane {
    width: 1fr;
}

#files-tree > .tree--cursor {
    background: $focused-selection;
    color: $text;
    text-style: bold;
}
